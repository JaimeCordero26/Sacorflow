{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sacorflow",
  "main": "worker.ts",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Dominio: usa un SUBDOMINIO para no pisar el sitio principal sacortech.xyz.
  // Descomenta y ajusta tras crear la zona/DNS en Cloudflare:
  // "routes": [
  //   { "pattern": "dashboard.sacortech.xyz", "custom_domain": true }
  // ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },

  // --- D1 (SQLite) ---
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sacortech-db",
      "database_id": "b05f2cb9-5f05-425e-a696-7af6c4d1ca11",
      "migrations_dir": "drizzle/migrations"
    }
  ],

  // --- Durable Objects (chat rooms, one per project) ---
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ],

  // --- Workers AI (desglose de ideas en issues) ---
  "ai": {
    "binding": "AI"
  },

  // --- R2 (declared for a future file-upload phase; unused for now) ---
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "sacortech-files"
    }
  ],

  // --- Rate limiting (public /p/[token] brute-force protection) ---
  "unsafe": {
    "bindings": [
      {
        "name": "PUBLIC_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 30, "period": 60 }
      }
    ]
  },

  "vars": {
    // Non-secret defaults. Secrets (SESSION_SECRET, GITHUB_APP_*, TELEGRAM_*)
    // are set via `wrangler secret put` or a .dev.vars file for local dev.
    "APP_NAME": "SacorTech Dashboard"
  }
}
